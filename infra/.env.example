# =============================================================================
# infra/.env — read by docker compose ONLY
#
#   cp infra/.env.example infra/.env
#
# Container images, published ports and the credentials Postgres and MinIO are
# created with. Nothing here is read by application code: the API reads
# backend/.env, the browser bundle reads frontend/.env.
#
# Development defaults. None is safe outside localhost.
# =============================================================================

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=sourcehub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# The password db/000_extensions.sql creates the sourcehub_app role with.
# Compose passes it to the API container; keep the two in step until the role
# password moves to a secret store.
SOURCEHUB_APP_PASSWORD=sourcehub_app_dev_password

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=sourcehub
MINIO_ROOT_PASSWORD=sourcehub_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit -----------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- pgAdmin (profile: tools) ------------------------------------------------
PGADMIN_EMAIL=admin@sourcehub.local
PGADMIN_PASSWORD=sourcehub
PGADMIN_PORT=5050

# --- Application ports (used once the api/web services are uncommented) ------
API_PORT=8000
WEB_PORT=5173
