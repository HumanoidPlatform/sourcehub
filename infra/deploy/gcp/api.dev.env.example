# /opt/stack/api.env on the DEV VM. Copy, fill in every <...>, chmod 600.
# Never commit the filled copy. One setting per line, no quotes, no spaces
# around "=", and a "$" in a value must be written "$$".

# --- Database: the db container on this VM ----------------------------------
DATABASE_URL=postgresql+asyncpg://sourcehub_app:<app password, URL-encoded>@db:5432/appdb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Platform storage: the dev bucket, signed keylessly by the VM's account ---
STORAGE_PROVIDER=gcs
STORAGE_GCS_BUCKET=<dev bucket, e.g. dm360-dev-files>

# --- Mail ----------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=vaieoncosarathi@gmail.com
SMTP_PASSWORD=<the Gmail app password>
SMTP_FROM=vaieoncosarathi@gmail.com

JWT_SECRET=<64 hex characters, different from prod>
APP_BASE_URL=https://<dev host, e.g. dev.example.com>
CORS_ALLOWED_ORIGINS=https://<dev host>

# --- The clocks: OFF in dev, or dev mails and pushes to real people ----------
# They default to true in code. The bidding sweep is in-app only, so it may run.
ENGAGEMENT_ENABLED=false
PUSH_ENABLED=false
BIDDING_SWEEP_ENABLED=true
