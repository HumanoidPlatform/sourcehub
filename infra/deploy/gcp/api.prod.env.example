# /opt/stack/api.env on the PROD VM. Copy, fill in every <...>, chmod 600.
# Never commit the filled copy. One setting per line, no quotes, no spaces
# around "=", and a "$" in a value must be written "$$".

# --- Database: Cloud SQL over its private IP --------------------------------
# sourcehub_app, never the postgres admin: the API refuses to start as a
# superuser, a BYPASSRLS login or the table owner (that is row security).
DATABASE_URL=postgresql+asyncpg://sourcehub_app:<app password, URL-encoded>@<cloud sql private ip>:5432/appdb
PGSSLMODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Platform storage: the prod bucket, signed keylessly by the VM's account --
STORAGE_PROVIDER=gcs
STORAGE_GCS_BUCKET=<prod bucket, e.g. dm360-prod-files>

# --- Mail (Gmail for now; port 587 — Google Cloud blocks 25) -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=vaieoncosarathi@gmail.com
SMTP_PASSWORD=<a NEW Gmail app password>
SMTP_FROM=vaieoncosarathi@gmail.com

# --- Auth: generate on the VM, once: openssl rand -hex 32 --------------------
JWT_SECRET=<64 hex characters>

# --- Where links in emails point -------------------------------------------
APP_BASE_URL=https://<app host, e.g. app.example.com>
CORS_ALLOWED_ORIGINS=https://<app host>

# --- The clocks inside the API: on in prod, and only here --------------------
ENGAGEMENT_ENABLED=true
ENGAGEMENT_TICK_SECONDS=300
BIDDING_SWEEP_ENABLED=true
BIDDING_SWEEP_TICK_SECONDS=60
PUSH_ENABLED=true
PUSH_TICK_SECONDS=5
EXPO_ACCESS_TOKEN=

# --- The mail outbox: partners are e-mailed when an RFP is published or awarded ---
MAIL_OUTBOX_ENABLED=true
MAIL_OUTBOX_TICK_SECONDS=5
