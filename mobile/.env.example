# DEVELOPMENT ONLY. Read by a bundle served live by Metro (`expo start`), and
# by nothing a worker installs: preview and production builds, and every
# over-the-air update, use PRODUCTION_API_URL in src/config.ts and ignore this.
#
# Where the API lives, as reachable FROM THE PHONE. Either the deployed
# platform, or an API on your laptop by its Wi-Fi address (ipconfig) — never
# localhost. Changeable at runtime from the sign-in screen in development.
EXPO_PUBLIC_API_URL=https://cosarathi.eastus.cloudapp.azure.com
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# The subject check (validation/subject.ts) needs the on-device labeller,
# which Expo Go does not have. To try the keep-or-retake flow in Expo Go,
# pretend every photo shows these labels (name:confidence, comma-separated).
# Development bundles only, like everything in this file.
# EXPO_PUBLIC_SUBJECT_STUB=Floor:0.9,Hand:0.6
