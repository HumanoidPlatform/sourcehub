{
  "expo": {
    "name": "DataMind360 Capture",
    "slug": "cosarathi-capture",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cosarathi",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.cosarathi.capture",
      "infoPlist": {
        "NSCameraUsageDescription": "DataMind360 Capture photographs and films the subject of your assignment.",
        "NSMicrophoneUsageDescription": "Needed to record sound with video captures.",
        "NSLocationWhenInUseUsageDescription": "Each capture is tagged with where it was taken.",
        "NSMotionUsageDescription": "Used to show a level in the viewfinder and record how square each capture was.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.cosarathi.capture",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DataMind360 Capture photographs and films the subject of your assignment.",
          "microphonePermission": "Needed to record sound with video captures.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Each capture is tagged with where it was taken."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Used to show a level in the viewfinder and record how square each capture was."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fa7e6c0-abcf-46e0-9837-d66e5046badc"
      }
    },
    "owner": "jituexpo2026",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5fa7e6c0-abcf-46e0-9837-d66e5046badc"
    }
  }
}
