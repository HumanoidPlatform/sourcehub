{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "video": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "video",
      "env": { "APP_VARIANT": "video" }
    },
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "dev",
      "env": { "APP_VARIANT": "dev" }
    },
    "production": {
      "channel": "production"
    }
  }
}
