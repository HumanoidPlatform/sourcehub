# =============================================================================
# frontend/.env — read by the Vite build
#
#   cp frontend/.env.example frontend/.env
#
# EVERY VITE_-PREFIXED VALUE HERE IS INLINED INTO THE JAVASCRIPT BUNDLE AND
# SERVED TO EVERY VISITOR. Treat this file as public. It is not a place where a
# secret can be "temporarily" parked.
#
# If you find yourself wanting an API key here, the answer is a backend
# endpoint that holds the key and proxies the call.
#
# Anything not prefixed with VITE_ is invisible to the client code, so the
# prefix is the whole safety boundary — which is exactly why backend secrets
# live in backend/.env, in a file this build never opens.
# =============================================================================

# Where the API lives. Same-origin in production behind the reverse proxy.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Shown in the UI footer and sent with error reports.
VITE_APP_NAME=SourceHub
VITE_APP_ENV=development

# Feature flags. Public by definition — never gate access with one, only
# presentation. Access is decided by the capability set the token carries,
# which the database produces via user_capabilities().
VITE_ENABLE_DESIGN_SYSTEM_ROUTE=true
VITE_ENABLE_COMMAND_PALETTE=true
