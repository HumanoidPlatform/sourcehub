# =============================================================================
# backend/.env — read by src/sourcehub/config.py, and nowhere else
#
#   cp backend/.env.example backend/.env
#
# This file contains secrets. It is never read by the frontend build, which is
# the entire point of keeping the three .env files apart: Vite inlines every
# VITE_-prefixed variable into the bundle it ships to the browser, so a shared
# file puts JWT_SECRET one careless prefix away from being served publicly.
#
# config.py is the ONLY place in the codebase that reads os.environ. Everything
# else takes settings as an argument.
#
# Hostnames below are localhost for running the API on the host against the
# compose stack. Inside a container use the service names — postgres, redis,
# minio, mailpit.
# =============================================================================

# --- Database ----------------------------------------------------------------
# The application connects as sourcehub_app, NOT as postgres.
# A superuser bypasses row-level security unconditionally, which would leave
# RLS enabled and entirely ineffective — the most common way this control fails
# silently (see db/100_rls.sql).
DATABASE_URL=postgresql+asyncpg://sourcehub_app:sourcehub_app_dev_password@localhost:5432/sourcehub

# Migrations and the isolation tests need the owner account.
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sourcehub

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis and Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object storage ----------------------------------------------------------
# Selects the adapter in platform/storage/. Swapping this to azure_blob is the
# whole of the storage migration, provided nothing outside platform/ imports a
# vendor SDK.
STORAGE_BACKEND=minio
# Embedded in every presigned URL and covered by its signature, so it must be
# the address the UPLOADING DEVICE can reach. localhost works for the console
# on this machine. For the worker-app pilot set the machine's LAN address,
# e.g. http://192.168.1.20:9000, and open port 9000 on the firewall — the
# console keeps working because the LAN address is reachable here too.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=sourcehub
STORAGE_SECRET_KEY=sourcehub_dev_password
STORAGE_BUCKET_ASSETS=sourcehub-assets
STORAGE_BUCKET_DOCUMENTS=sourcehub-documents
STORAGE_BUCKET_BUNDLES=sourcehub-bundles
# Pre-signed URLs are scoped to one object with a short TTL.
STORAGE_PRESIGN_TTL_SECONDS=900

# --- Mail --------------------------------------------------------------------
# Selects the adapter in platform/mail/.
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@sourcehub.local
# Mailpit catches everything in development: http://localhost:8025
# Not optional here — onboarding issues an invitation token by email and the
# invitee sets their own password from that link.

# --- Authentication ----------------------------------------------------------
# Database-only. The Keycloak seam exists in the schema
# (app_user.external_idp, external_idp_subject) but is unused.
AUTH_BACKEND=database
JWT_SECRET=change-me-in-any-non-local-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_HASH_ALGO=argon2id
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
INVITATION_TTL_DAYS=14
# Where invitation and reset links point: the console's origin. A worker
# accepts their invitation on this page before signing in to the app.
APP_BASE_URL=http://localhost:5173

# --- CORS --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
OTEL_ENABLED=false

# --- Seeded administrator ----------------------------------------------------
# Created by db/900_seed.sql with must_change_password = true.
SEED_ADMIN_EMAIL=admin@sourcehub.local
SEED_ADMIN_PASSWORD=SourceHub#2026
