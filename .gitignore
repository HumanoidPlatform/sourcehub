# =============================================================================
# Three .env files, three ignores. Each sits beside its committed .env.example.
#
# The frontend one matters as much as the others despite holding no secrets:
# a developer pointing VITE_API_BASE_URL at a colleague's machine should not be
# committing that for everyone.
#
# .env.* covers what people actually leave lying around while switching a
# deployment: .env.local-backup, .env.azure, .env.old. *.env alone does not —
# it only matches names ENDING in .env — so every one of those showed up as
# untracked and a git add -A would have committed a database password. The
# re-include for .env.example must stay last: git takes the final match.
# =============================================================================
.env
*.env
.env.*
!.env.example
backend/.env
frontend/.env
infra/.env

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# --- Node --------------------------------------------------------------------
node_modules/
frontend/dist/
*.tsbuildinfo
npm-debug.log*

# --- Editors and OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local artefacts ---------------------------------------------------------
*.log
.claude/

# --- Build artifacts ----------------------------------------------------------
# Generated from db/*.sql by `make bundle`. Not committed: a second copy of the
# schema is a second thing to keep in step.
build/
