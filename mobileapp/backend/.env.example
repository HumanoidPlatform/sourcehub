# Cosaarthi mobile backend local development.
# Copy to mobileapp/backend/.env. Never put these values in mobileapp/app/.env.

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8001
CORS_ALLOWED_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://cosaarthi_mobile_app:cosaarthi_mobile_app_dev_password@127.0.0.1:55432/cosaarthi_mobile
DATABASE_ADMIN_URL=postgresql+asyncpg://cosaarthi_mobile_owner:cosaarthi_mobile_owner_dev_password@127.0.0.1:55432/cosaarthi_mobile
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

JWT_SECRET=change-me-before-any-non-local-environment
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

MINIO_ENDPOINT=127.0.0.1:59000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:59000
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MINIO_ACCESS_KEY=cosaarthi
MINIO_SECRET_KEY=cosaarthi_mobile_dev_password
MINIO_BUCKET_MEDIA=cosaarthi-mobile-media
MINIO_REGION=us-east-1
MINIO_PRESIGN_TTL_SECONDS=900

MAX_IMAGE_UPLOAD_BYTES=26214400

DEV_SEED_EMAIL=anita@crowd.in
DEV_SEED_PASSWORD=Cosaarthi#2026
